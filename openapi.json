{
  "openapi": "3.1.0",
  "info": {
    "title": "PolyGate BrowZine Mock API",
    "version": "0.2.0",
    "description": "Synthetic mock of BrowZine-style journal search, bookshelf, notifications, saved articles and citation export. Single mock user (U1); no authentication. All routes are our own design, not a published BrowZine schema. Dates are local Hong Kong time. See docs/API_DESIGN.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Journals"
    },
    {
      "name": "Bookshelf"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Saved articles"
    },
    {
      "name": "Citations"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/journals": {
      "get": {
        "tags": [
          "Journals"
        ],
        "operationId": "search_journals",
        "summary": "Search journals",
        "description": "Find journals by title substring, subject or ISSN. Filters combine with AND; no filter lists all. Sorted by title.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "example": "neural",
            "description": "Case-insensitive title substring."
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "example": "Artificial Intelligence",
            "description": "Exact subject, case-insensitive."
          },
          {
            "name": "issn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$"
            },
            "example": "2049-3630"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalList"
                },
                "example": {
                  "data": [
                    {
                      "journal_id": "J03",
                      "title": "Neural Computation Letters",
                      "issn": "2049-3630",
                      "subject": "Artificial Intelligence",
                      "in_bookshelf": false
                    }
                  ],
                  "meta": {
                    "total": 1,
                    "limit": 20,
                    "offset": 0
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/journals/{journal_id}": {
      "get": {
        "tags": [
          "Journals"
        ],
        "operationId": "get_journal_details",
        "summary": "Get journal details",
        "description": "One journal with its issues, newest first.",
        "parameters": [
          {
            "name": "journal_id",
            "in": "path",
            "required": true,
            "description": "Journal identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "J03"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalResponse"
                },
                "example": {
                  "data": {
                    "journal_id": "J03",
                    "title": "Neural Computation Letters",
                    "issn": "2049-3630",
                    "subject": "Artificial Intelligence",
                    "publisher": "PolyGate Synthetic Press",
                    "in_bookshelf": false,
                    "issues": [
                      {
                        "issue_id": "I06",
                        "volume": 12,
                        "issue_number": 4,
                        "year": 2026,
                        "publication_date": null,
                        "status": "in_press",
                        "article_count": 3
                      },
                      {
                        "issue_id": "I05",
                        "volume": 12,
                        "issue_number": 3,
                        "year": 2026,
                        "publication_date": "2026-09-15",
                        "status": "published",
                        "article_count": 3
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "The journal does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/journals/{journal_id}/articles": {
      "get": {
        "tags": [
          "Journals"
        ],
        "operationId": "list_articles_by_journal",
        "summary": "List articles by journal",
        "description": "The only article-discovery route: article IDs and basic metadata, newest issue first.",
        "parameters": [
          {
            "name": "journal_id",
            "in": "path",
            "required": true,
            "description": "Journal identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "J03"
          },
          {
            "name": "issue_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "I05",
            "description": "Restrict to one issue of this journal."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleList"
                },
                "example": {
                  "data": [
                    {
                      "article_id": "A013",
                      "journal_id": "J03",
                      "journal_title": "Neural Computation Letters",
                      "issue_id": "I05",
                      "volume": 12,
                      "issue_number": 3,
                      "year": 2026,
                      "title": "Spiking Network Models for Sensor Fusion",
                      "authors": [
                        "Chan, Wai Ming",
                        "Lee, Sze Yan"
                      ],
                      "start_page": 101,
                      "end_page": 115,
                      "doi": "10.9999/ncl.12.3.101",
                      "saved": false
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The journal does not exist, the issue does not exist, or the issue belongs to another journal.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/bookshelf": {
      "get": {
        "tags": [
          "Bookshelf"
        ],
        "operationId": "list_bookshelf",
        "summary": "List bookshelf",
        "description": "Followed journals in the order followed, with unread notification counts.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookshelf"
                },
                "example": {
                  "data": [
                    {
                      "journal_id": "J03",
                      "title": "Neural Computation Letters",
                      "issn": "2049-3630",
                      "subject": "Artificial Intelligence",
                      "unread_count": 1
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bookshelf"
        ],
        "operationId": "add_to_bookshelf",
        "summary": "Add to bookshelf",
        "description": "Follow a journal. Its notifications become visible.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddBookshelfRequest"
              },
              "example": {
                "journal_id": "J03"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Journal followed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookshelfEntryResponse"
                },
                "example": {
                  "data": {
                    "journal_id": "J03",
                    "title": "Neural Computation Letters",
                    "issn": "2049-3630",
                    "subject": "Artificial Intelligence",
                    "unread_count": 1
                  }
                }
              }
            }
          },
          "404": {
            "description": "The journal does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The journal is already on the bookshelf.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/bookshelf/{journal_id}": {
      "delete": {
        "tags": [
          "Bookshelf"
        ],
        "operationId": "remove_from_bookshelf",
        "summary": "Remove from bookshelf",
        "description": "Unfollow a journal. Its notifications are hidden but keep their read state.",
        "parameters": [
          {
            "name": "journal_id",
            "in": "path",
            "required": true,
            "description": "Journal identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "J03"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "The journal does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The journal is not on the bookshelf.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "operationId": "list_notifications",
        "summary": "List notifications",
        "description": "New published issues of bookshelf journals. Newest first.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "unread",
                "read",
                "all"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationList"
                },
                "example": {
                  "data": [
                    {
                      "notification_id": "N-I05",
                      "journal_id": "J03",
                      "journal_title": "Neural Computation Letters",
                      "issue_id": "I05",
                      "volume": 12,
                      "issue_number": 3,
                      "publication_date": "2026-09-15",
                      "article_count": 3,
                      "read": false
                    }
                  ],
                  "meta": {
                    "unread_count": 1
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/{notification_id}/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "mark_notification_read",
        "summary": "Mark notification read",
        "description": "Takes no request body; any body is rejected with 422 and nothing changes.",
        "parameters": [
          {
            "name": "notification_id",
            "in": "path",
            "required": true,
            "description": "Notification identifier, N-<issue_id>.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "N-I05"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated notification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                },
                "example": {
                  "data": {
                    "notification_id": "N-I05",
                    "journal_id": "J03",
                    "journal_title": "Neural Computation Letters",
                    "issue_id": "I05",
                    "volume": 12,
                    "issue_number": 3,
                    "publication_date": "2026-09-15",
                    "article_count": 3,
                    "read": true
                  }
                }
              }
            }
          },
          "404": {
            "description": "The notification does not exist or its journal is not on the bookshelf.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The notification is already read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/saved-articles": {
      "get": {
        "tags": [
          "Saved articles"
        ],
        "operationId": "list_saved_articles",
        "summary": "List saved articles",
        "description": "Saved articles in the order saved.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleList"
                },
                "example": {
                  "data": [
                    {
                      "article_id": "A013",
                      "journal_id": "J03",
                      "journal_title": "Neural Computation Letters",
                      "issue_id": "I05",
                      "volume": 12,
                      "issue_number": 3,
                      "year": 2026,
                      "title": "Spiking Network Models for Sensor Fusion",
                      "authors": [
                        "Chan, Wai Ming",
                        "Lee, Sze Yan"
                      ],
                      "start_page": 101,
                      "end_page": 115,
                      "doi": "10.9999/ncl.12.3.101",
                      "saved": true
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Saved articles"
        ],
        "operationId": "save_article",
        "summary": "Save article",
        "description": "Save an article to My Articles. The journal need not be on the bookshelf.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveArticleRequest"
              },
              "example": {
                "article_id": "A013"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Article saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleResponse"
                },
                "example": {
                  "data": {
                    "article_id": "A013",
                    "journal_id": "J03",
                    "journal_title": "Neural Computation Letters",
                    "issue_id": "I05",
                    "volume": 12,
                    "issue_number": 3,
                    "year": 2026,
                    "title": "Spiking Network Models for Sensor Fusion",
                    "authors": [
                      "Chan, Wai Ming",
                      "Lee, Sze Yan"
                    ],
                    "start_page": 101,
                    "end_page": 115,
                    "doi": "10.9999/ncl.12.3.101",
                    "saved": true
                  }
                }
              }
            }
          },
          "404": {
            "description": "The article does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The article is already saved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/saved-articles/{article_id}": {
      "delete": {
        "tags": [
          "Saved articles"
        ],
        "operationId": "remove_saved_article",
        "summary": "Remove saved article",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
