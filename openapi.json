            "description": "Article identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "A013"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "The article does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The article is not saved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/saved-articles/{article_id}/citation": {
      "get": {
        "tags": [
          "Citations"
        ],
        "operationId": "export_citation",
        "summary": "Export citation",
        "description": "BibTeX or RIS record built only from stored metadata. BibTeX key: lowercase first-author surname + year + lowercase article ID.",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "description": "Article identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "example": "A013"
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bibtex",
                "ris"
              ]
            },
            "example": "bibtex"
          }
        ],
        "responses": {
          "200": {
            "description": "Citation text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "bibtex": {
                    "summary": "format=bibtex",
                    "value": "@article{chan2026a013,\n  author = {Chan, Wai Ming and Lee, Sze Yan},\n  title = {Spiking Network Models for Sensor Fusion},\n  journal = {Neural Computation Letters},\n  year = {2026},\n  volume = {12},\n  number = {3},\n  pages = {101--115},\n  doi = {10.9999/ncl.12.3.101},\n  issn = {2049-3630}\n}\n"
                  },
                  "ris": {
                    "summary": "format=ris",
                    "value": "TY  - JOUR\nAU  - Chan, Wai Ming\nAU  - Lee, Sze Yan\nTI  - Spiking Network Models for Sensor Fusion\nJO  - Neural Computation Letters\nPY  - 2026\nVL  - 12\nIS  - 3\nSP  - 101\nEP  - 115\nDO  - 10.9999/ncl.12.3.101\nSN  - 2049-3630\nER  - \n"
                  }
                }
              }
            }
          },
          "404": {
            "description": "The article does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The article is not saved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "health_check",
        "summary": "Health check",
        "description": "Platform probe; kept as plain {\"status\": \"ok\"}, outside the data envelope.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot be read."
          },
          "422": {
            "description": "Invalid input: malformed ID, bad query value, missing or unknown field.",
            "content": {
              "application/problem+json": {
                "schema": {
